# Copie este archivo como .env y complete los valores.
# NUNCA suba el archivo .env ni la clave de la cuenta de servicio a GitHub.

# ID del proyecto de Firebase
FIREBASE_PROJECT_ID=app-eventos-unadeca

# Ruta a la clave de la cuenta de servicio (descargada desde Firebase Console).
# Guárdela fuera del repositorio o en backend/ (está en .gitignore).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Servidor
PORT=3000
NODE_ENV=development

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173
