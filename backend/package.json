{
  "name": "app-eventos-unadeca-backend",
  "version": "1.0.0",
  "description": "API REST de la App de Eventos y Actividades UNADECA (Node.js + Express + Firebase)",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint --no-eslintrc --env node,es2022 --parser-options=ecmaVersion:2022 --rule \"complexity:[2,10]\" src"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "firebase-admin": "^12.7.0",
    "helmet": "^7.2.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/config/**",
      "!src/facade/**",
      "!src/container.js"
    ]
  }
}
