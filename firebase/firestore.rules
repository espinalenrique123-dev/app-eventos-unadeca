rules_version = '2';

// Reglas de seguridad de Firestore — App de Eventos UNADECA
//
// Toda escritura pasa por el backend (Admin SDK), que valida roles, cupos y
// estados. Por eso los clientes (webapp y Android) solo tienen lectura limitada
// y ninguna escritura directa.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Cada usuario puede leer solo su propio documento.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Los eventos son visibles para cualquier usuario autenticado.
    match /events/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Un estudiante solo puede leer sus propias inscripciones.
    match /inscriptions/{inscriptionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // La asistencia solo se consulta a través del backend.
    match /attendance/{attendanceId} {
      allow read, write: if false;
    }

    // Cualquier otra colección queda cerrada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
