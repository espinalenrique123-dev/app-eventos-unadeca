rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdministrator() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
          in ['admin', 'administrador']
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('active', true) != false;
    }

    function isStudent() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
          in ['student', 'estudiante']
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('active', true) != false;
    }

    function canUpdateContactProfile() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(['name', 'phone', 'contactEmail'])
        && (
          !changedKeys.hasAny(['name'])
          || (
            request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 80
          )
        )
        && (
          !changedKeys.hasAny(['phone'])
          || (
            request.resource.data.phone is string
            && request.resource.data.phone.size() > 0
            && request.resource.data.phone.size() <= 25
          )
        )
        && (
          !changedKeys.hasAny(['contactEmail'])
          || (
            request.resource.data.contactEmail is string
            && request.resource.data.contactEmail.size() <= 254
            && request.resource.data.contactEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          )
        );
    }

    function canRegisterForEvent() {
      let oldRegistrations = resource.data.get('registrations', []);
      let newRegistrations = request.resource.data.get('registrations', []);
      let oldCapacity = resource.data.get('capacity', 0);

      return isStudent()
        && oldRegistrations is list
        && newRegistrations is list
        && request.auth.token.email is string
        && !oldRegistrations.hasAny([request.auth.token.email])
        && newRegistrations.hasAll(oldRegistrations)
        && newRegistrations.size() == oldRegistrations.size() + 1
        && newRegistrations.hasAny([request.auth.token.email])
        && oldCapacity is number
        && oldCapacity > 0
        && request.resource.data.get('capacity', 0) == oldCapacity - 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'registrations', 'capacity'
        ]);
    }

    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role in ['student', 'estudiante']
        && request.resource.data.active == true;
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdministrator()
      );
      allow update: if request.auth != null
        && request.auth.uid == userId
        && canUpdateContactProfile();
    }

    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdministrator();
      allow update: if isAdministrator() || canRegisterForEvent();
    }
  }
}
