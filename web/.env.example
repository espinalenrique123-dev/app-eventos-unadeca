# Copie este archivo como .env.local y complete los valores de su app web de Firebase
# (Firebase Console → Configuración del proyecto → Tus apps → App web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=app-eventos-unadeca.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=app-eventos-unadeca
VITE_FIREBASE_APP_ID=

# URL del backend (en desarrollo, Vite redirige /api a http://localhost:3000)
VITE_API_URL=/api
